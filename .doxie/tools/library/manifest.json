{
  "id": "library",
  "displayName": "Brain",
  "description": "Query local semantic knowledge, record verified learnings and connect weighted evidence.",
  "kind": "workflow",
  "category": "Tool",
  "modes": {
    "query": {
      "description": "Retrieve a bounded set of relevant global memories without a workspace.",
      "fields": [
        {
          "id": "query",
          "label": "Search knowledge",
          "required": true,
          "placeholder": "What knowledge would help this step?"
        },
        {
          "id": "libraryId",
          "label": "Collection (optional)",
          "lookup": "libraries"
        },
        {
          "id": "limit",
          "label": "Maximum results",
          "placeholder": "8"
        }
      ]
    },
    "remember": {
      "description": "Save a reusable fact, lesson, entity or parameter with provenance.",
      "fields": [
        {
          "id": "title",
          "label": "Title",
          "required": true
        },
        {
          "id": "content",
          "label": "Knowledge to remember",
          "required": true,
          "multiline": true
        },
        {
          "id": "kind",
          "label": "Kind",
          "placeholder": "memory, entity or parameter"
        },
        {
          "id": "origin",
          "label": "Knowledge origin",
          "placeholder": "learned or optimized"
        },
        {
          "id": "reviewAfter",
          "label": "Review after (ISO date)",
          "placeholder": "2027-01-01T00:00:00Z"
        },
        {
          "id": "libraryId",
          "label": "Collection (optional)",
          "lookup": "libraries"
        },
        {
          "id": "tags",
          "label": "Tags",
          "placeholder": "Comma-separated tags"
        },
        {
          "id": "parameters_json",
          "label": "Structured parameters (JSON object)",
          "multiline": true
        },
        {
          "id": "source",
          "label": "Source or provenance label"
        }
      ]
    },
    "graph": {
      "description": "Explore a local neighborhood and its semantic and evidence weights.",
      "fields": [
        { "id": "nodeId", "label": "Center memory ID" },
        { "id": "query", "label": "Search knowledge" },
        { "id": "minWeight", "label": "Minimum connection strength (0–1)", "placeholder": "0.5" }
      ]
    },
    "review": {
      "description": "Revalidate, flag or archive a memory while retaining its history.",
      "fields": [
        { "id": "id", "label": "Memory ID", "required": true },
        { "id": "status", "label": "Review status", "placeholder": "current, stale or archived", "required": true },
        { "id": "evidence", "label": "Review evidence", "multiline": true, "required": true },
        { "id": "reviewAfter", "label": "Review after (ISO date)" }
      ]
    },
    "relate": {
      "description": "Record how two global memories are related.",
      "fields": [
        {
          "id": "fromId",
          "label": "Source memory ID",
          "required": true
        },
        {
          "id": "toId",
          "label": "Target memory ID",
          "required": true
        },
        {
          "id": "type",
          "label": "Relation",
          "placeholder": "supports, contradicts, supersedes, related or mentions"
        },
        {
          "id": "weight",
          "label": "Connection strength (0–1)",
          "placeholder": "1"
        }
      ]
    }
  }
}
