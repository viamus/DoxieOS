@* Visual mockup — AI Builder chat panel.

   Reused by /agents/new and /workflows/new/chat. Renders an assistant ↔ user
   conversation, an inline "tool-call" affordance for drafted artefacts, an
   empty-state suggestion row, and a composer at the bottom. Not wired —
   the input field is non-functional and Send is a no-op. The host page
   supplies all messages as hardcoded mock data so the layout can be
   validated before any model wiring. *@

<MudPaper Elevation="2" Class="d-flex flex-column"
          Style="height: 100%; min-height: 0; background: var(--mud-palette-surface); overflow: hidden;">

    @* Header strip — model chip + reset *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
              Class="px-4 py-2"
              Style="border-bottom: 1px solid var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
        <MudText Typo="Typo.subtitle2">@Title</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                 Color="Color.Default"
                 Icon="@Icons.Material.Filled.Memory">@Model</MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                       Size="Size.Small" Color="Color.Default"
                       title="Restart conversation" />
    </MudStack>

    @* Messages area *@
    <div class="flex-grow-1" style="overflow-y: auto; padding: 16px 16px 8px 16px;">
        @if (Messages is null || Messages.Count == 0)
        {
            <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="pa-6"
                      Style="height: 100%; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary"
                         Style="font-size: 48px;" />
                <MudText Typo="Typo.h5" Align="Align.Center">@EmptyHeadline</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center"
                         Style="max-width: 420px;">@EmptyHelp</MudText>

                @if (Suggestions is { Count: > 0 })
                {
                    <MudStack Row="true" Spacing="1" Class="mt-2 flex-wrap" Justify="Justify.Center">
                        @foreach (var s in Suggestions)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Bolt">@s</MudChip>
                        }
                    </MudStack>
                }
            </MudStack>
        }
        else
        {
            @foreach (var msg in Messages)
            {
                @switch (msg.Role)
                {
                    case BuilderChatRole.Assistant:
                        <div class="d-flex mb-3" style="gap: 10px;">
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       Style="margin-top: 2px;">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                            </MudAvatar>
                            <div style="max-width: 80%;">
                                <MudPaper Elevation="0"
                                          Class="pa-3"
                                          Style="background: rgba(217, 119, 87, 0.06); border-left: 3px solid var(--mud-palette-primary); border-radius: 4px 10px 10px 10px;">
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@msg.Body</MudText>
                                </MudPaper>
                            </div>
                        </div>
                        break;

                    case BuilderChatRole.User:
                        <div class="d-flex mb-3" style="gap: 10px; justify-content: flex-end;">
                            <div style="max-width: 80%;">
                                <MudPaper Elevation="0"
                                          Class="pa-3"
                                          Style="background: var(--mud-palette-background); border: 1px solid var(--mud-palette-divider); border-radius: 10px 4px 10px 10px;">
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@msg.Body</MudText>
                                </MudPaper>
                            </div>
                            <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                       Style="margin-top: 2px;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            </MudAvatar>
                        </div>
                        break;

                    case BuilderChatRole.ToolCall:
                        @* Inline action block — visually distinct from chat bubbles *@
                        <div class="d-flex mb-3" style="gap: 10px;">
                            <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                       Style="margin-top: 2px;">
                                <MudIcon Icon="@(msg.Icon ?? Icons.Material.Filled.Bolt)" Size="Size.Small" />
                            </MudAvatar>
                            <MudPaper Elevation="0" Class="pa-2 px-3"
                                      Style="background: var(--mud-palette-background); border: 1px dashed var(--mud-palette-divider); border-radius: 6px; max-width: 80%; font-family: 'Cascadia Code', Consolas, monospace;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.caption" Style="font-family: inherit;">
                                        @msg.Body
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(msg.Detail))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Default" Style="font-family: inherit;">
                                            · @msg.Detail
                                        </MudText>
                                    }
                                </MudStack>
                            </MudPaper>
                        </div>
                        break;
                }
            }

            @if (ShowTyping)
            {
                <div class="d-flex mb-3" style="gap: 10px;">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="margin-top: 2px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                    </MudAvatar>
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: rgba(217, 119, 87, 0.06); border-left: 3px solid var(--mud-palette-primary); border-radius: 4px 10px 10px 10px;">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <span class="builder-dot"></span>
                            <span class="builder-dot" style="animation-delay: .15s;"></span>
                            <span class="builder-dot" style="animation-delay: .3s;"></span>
                        </MudStack>
                    </MudPaper>
                </div>
            }
        }
    </div>

    @* Composer *@
    <div style="border-top: 1px solid var(--mud-palette-divider); padding: 10px 12px 12px 12px;">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                           Size="Size.Small" Color="Color.Default"
                           title="Attach a brief or existing definition (mockup)" />
            <MudTextField T="string"
                          Placeholder="@ComposerPlaceholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          FullWidth="true" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       Size="Size.Small">Send</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-1 d-block">
            Mockup — input is not wired. Use the right pane to inspect the proposed draft.
        </MudText>
    </div>
</MudPaper>

<style>
    .builder-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--mud-palette-primary);
        opacity: 0.6;
        animation: builder-blink 1.2s infinite ease-in-out;
    }
    @@keyframes builder-blink {
        0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
        40% { opacity: 1; transform: translateY(-2px); }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "AI Builder";
    [Parameter] public string Model { get; set; } = "Claude Sonnet 4.6";
    [Parameter] public string EmptyHeadline { get; set; } = "Describe what you want to build";
    [Parameter] public string EmptyHelp { get; set; } =
        "Tell me in plain language and I'll draft the configuration on the right. You can edit it any time.";
    [Parameter] public string ComposerPlaceholder { get; set; } = "Describe what you want…";
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }
    [Parameter] public IReadOnlyList<BuilderChatMessage>? Messages { get; set; }
    [Parameter] public bool ShowTyping { get; set; }
}
