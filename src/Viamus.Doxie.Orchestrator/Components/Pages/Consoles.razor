@page "/consoles"
@inject IConsoleSessionStore ConsoleStore
@inject IWorkspaceStore WorkspaceStore
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject Viamus.Doxie.Orchestrator.Services.AppLanguageService Lang
@implements IAsyncDisposable

<PageTitle>@Lang["Consoles.Title"] - DoxieOS</PageTitle>

@* Outer wrapper — when fullscreen, position: fixed covers the entire
   viewport (above MudBlazor's AppBar / Drawer z-indices), giving the
   user the whole document for the terminal session without invoking
   the browser's Fullscreen API. tabindex makes ESC reachable. *@
<div class="@(_isFullscreen ? "doxie-fullscreen" : null)"
     tabindex="-1"
     @onkeydown="@(e => { if (_isFullscreen && e.Key == "Escape") ToggleFullscreen(); })">

@if (!_isFullscreen)
{
    <MudBreadcrumbs Items="Breadcrumbs" Class="px-0 mb-2" />

    <MudText Typo="Typo.h3" GutterBottom="true">@Lang["Consoles.Title"]</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-4">
        @Lang["Consoles.Subtitle"]
    </MudText>
}

<MudGrid Spacing="3">
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Style="@($"height: {ConsoleHeight}; min-height: 420px; display: flex; flex-direction: column; overflow: hidden;")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-3 py-2" Style="border-bottom: 1px solid rgba(255,255,255,0.08); flex: 0 0 auto;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle2">@Lang["Consoles.Sessions"]</MudText>
                    @if (_sessions.Count > 0)
                    {
                        <span style="display: inline-flex; min-width: 20px; height: 20px; padding: 0 6px; align-items: center; justify-content: center; border-radius: 10px; background: rgba(217, 119, 87, 0.18); color: #d97757; font-size: 0.7rem; font-weight: 600; line-height: 1;">@_sessions.Count</span>
                    }
                </MudStack>
                <MudTooltip Text="@Lang["Consoles.NewSession"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="OpenCreateDialog" />
                </MudTooltip>
            </MudStack>

            <div style="flex: 1; overflow-y: auto; padding: 8px;">
                @if (_sessions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default" Class="pa-3" Style="font-style: italic;">
                        @Lang["Consoles.Empty"]
                    </MudText>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        var isActive = _active?.Id == s.Id;
                        var isRunning = s.Status == ConsoleSessionStatus.Running;
                        <div class="@(isActive ? "console-card console-card-active" : "console-card")"
                             @onclick="@(async () => await OnSelectedChanged(s))">
                            <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                                <MudIcon Icon="@SessionIcon(s)"
                                         Size="Size.Small"
                                         Color="@(isRunning ? Color.Success : Color.Default)"
                                         Style="flex: 0 0 auto;" />
                                <div style="flex: 1; min-width: 0;">
                                    <div style="font-size: 0.85rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @s.Label
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                        <span class="@(isRunning ? "console-pill-running" : "console-pill-exited")">@(isRunning ? Lang["Common.Running"] : Lang["Common.Exited"])</span>
                                        <span style="font-size: 0.7rem; color: rgba(255,255,255,0.45);">@RelativeTime(s.StartedAt)</span>
                                    </div>
                                </div>
                                <span @onclick:stopPropagation="true" style="flex: 0 0 auto;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="@(() => CloseSession(s))" />
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9">
        <MudPaper Elevation="1" Style="@($"height: {ConsoleHeight}; min-height: 420px; background: #1e1e1e; display: flex; flex-direction: column; overflow: hidden;")">
            @if (_active is null)
            {
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #888; gap: 16px;">
                    <pre style="margin: 0; color: #d97757; font-size: 11px; line-height: 1.2; font-family: 'Cascadia Code', Consolas, monospace;">@DoxieAscii</pre>
                    <div style="text-align: center;">
                        <div style="color: #d97757; font-weight: 600; margin-bottom: 4px;">@Lang["Consoles.NoSelected"]</div>
                        <div style="color: #888; font-size: 0.85rem;">@Lang["Consoles.NoSelectedBody"]</div>
                    </div>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-bottom: 1px solid rgba(255,255,255,0.08); flex: 0 0 auto; background: rgba(0,0,0,0.2);">
                    <MudIcon Icon="@SessionIcon(_active)" Size="Size.Small" Style="color: #d97757;" />
                    <div style="font-weight: 600; color: #e6e6e6; font-size: 0.9rem;">@_active.Label</div>
                    <div style="font-family: 'Cascadia Code', Consolas, monospace; font-size: 0.75rem; color: rgba(255,255,255,0.45); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1;">@_active.WorkspacePath</div>
                    <VoiceInputButton MountId="@_mountId" />
                    <span class="@(_active.Status == ConsoleSessionStatus.Running ? "console-pill-running" : "console-pill-exited")" style="flex: 0 0 auto;">@(_active.Status == ConsoleSessionStatus.Running ? Lang["Common.Running"] : Lang["Common.Exited"])</span>
                    <MudTooltip Text="@(_isFullscreen ? Lang["Consoles.ExitFullscreen"] : Lang["Consoles.Fullscreen"])">
                        <MudIconButton Icon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                                       Size="Size.Small"
                                       Style="color: #d97757; flex: 0 0 auto;"
                                       OnClick="ToggleFullscreen" />
                    </MudTooltip>
                </div>
                @* Mount div fills the remaining vertical space (flex:1)
                   so xterm's fit-addon picks the right cols/rows on first
                   layout. ResizeObserver in terminals.js refits whenever
                   this box's measured size changes. *@
                <div @key="_active.Id" id="@_mountId" style="flex: 1; min-height: 0; padding: 6px;"></div>
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@if (_showCreateDialog)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudPaper Class="pa-5" Elevation="8" Style="min-width: 420px; max-width: 520px;">
            <MudText Typo="Typo.h6" Class="mb-3">@Lang["Consoles.NewConsole"]</MudText>

            @if (_workspaces.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    @Lang["Consoles.NoWorkspaces"] <MudLink Href="/workspaces">@Lang["Consoles.CreateWorkspaceFirst"]</MudLink>
                </MudAlert>
            }
            else
            {
                <MudSelect T="string"
                           Label="@Lang["Consoles.Workspace"]"
                           Value="_createWorkspaceId"
                           ValueChanged="@(v => _createWorkspaceId = v ?? string.Empty)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           FullWidth="true"
                           HelperText="@Lang["Consoles.WorkspaceHelper"]">
                    @foreach (var ws in _workspaces)
                    {
                        <MudSelectItem T="string" Value="@ws.Id">@ws.Name <MudText Typo="Typo.caption" Color="Color.Default" Inline="true">@($" ({ws.Id})")</MudText></MudSelectItem>
                    }
                </MudSelect>
            }

            @if (!string.IsNullOrEmpty(_createError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_createError</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Text" OnClick="@(() => _showCreateDialog = false)">@Lang["Common.Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SubmitCreate"
                           Disabled="@(_creating || _workspaces.Count == 0 || string.IsNullOrEmpty(_createWorkspaceId))">
                    @Lang["Common.Start"]
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

</div>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public string? IdQueryParam { get; set; }

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new BreadcrumbItem(Lang["Common.Home"], href: "/"),
        new BreadcrumbItem(Lang["Consoles.Title"], href: null, disabled: true),
    ];

    private IReadOnlyList<ConsoleSession> _sessions = Array.Empty<ConsoleSession>();
    private IReadOnlyList<Workspace> _workspaces = Array.Empty<Workspace>();
    private ConsoleSession? _active;
    private string _mountId = "console-mount-" + Guid.NewGuid().ToString("N")[..8];
    private string? _attachedSessionId;

    private bool _showCreateDialog;
    private string _createWorkspaceId = string.Empty;
    private string _createError = string.Empty;
    private bool _creating;

    // True when the page wrapper covers the entire viewport. Toggled
    // from the icon button in the active session's header strip or by
    // ESC keydown when the wrapper has focus. CSS-only — same pattern
    // as WorkspaceFiles.razor, NOT the browser's Fullscreen API.
    private bool _isFullscreen;

    // Panel height adapts to the freed vertical space when fullscreen
    // hides the breadcrumbs / h3 / subtitle chrome. 64px leaves room
    // for the "Show hidden" / fullscreen-button row.
    private string ConsoleHeight => _isFullscreen ? "calc(100vh - 64px)" : "calc(100vh - 260px)";

    // ASCII art credit: hjw (signature kept on the canvas).
    // Reused from AgentDetail so the empty state has the same dachshund
    // motif as the rest of DoxieOS.
    private const string DoxieAscii =
"""
                              __
       ,                    ," e`--o  <Woof>
      ((                   (  | __,'      <Woof>
       \\~----------------' \_;/      <Woof>
       (                      /
       /) ._______________.  )
      (( (               (( (
       ``-'               ``-'
""";

    private void ToggleFullscreen()
    {
        // The MudPaper height binds to ConsoleHeight which depends on
        // _isFullscreen, so flipping the flag re-renders both panes at
        // their new size; xterm's ResizeObserver in terminals.js then
        // refits cols/rows automatically — no manual JS interop needed.
        _isFullscreen = !_isFullscreen;
    }

    protected override void OnInitialized()
    {
        Reload();

        // Deep-link: /consoles?id=<sessionId> auto-selects that session
        // when the user arrives from "Open Claude here" on a workspace.
        if (!string.IsNullOrWhiteSpace(IdQueryParam))
        {
            _active = _sessions.FirstOrDefault(s => string.Equals(s.Id, IdQueryParam, StringComparison.OrdinalIgnoreCase));
        }
        _active ??= _sessions.FirstOrDefault();

        ConsoleStore.SessionCreated += OnStoreChanged;
        ConsoleStore.SessionRemoved += OnStoreChanged;
        ConsoleStore.SessionUpdated += OnStoreChanged;
    }

    private void Reload()
    {
        // Filter Builder-kind sessions out of the regular Consoles page —
        // those belong to /agents/new and /workflows/new/chat. They share
        // the same PTY infra but live in their own UI surface.
        _sessions = ConsoleStore.ListAll()
            .Where(s => s.Kind is ConsoleSessionKind.Workspace or ConsoleSessionKind.Auth)
            .ToList();
        _workspaces = WorkspaceStore.ListAll();
    }

    private async void OnStoreChanged(ConsoleSession _)
    {
        await InvokeAsync(() =>
        {
            Reload();
            // Active session may have been removed externally.
            if (_active is not null && !_sessions.Any(s => s.Id == _active.Id))
            {
                _active = null;
            }
            StateHasChanged();
        });
    }

    private async Task OnSelectedChanged(ConsoleSession? value)
    {
        if (value is null || ReferenceEquals(value, _active)) return;
        await DetachCurrentAsync();
        _active = value;
        // Force a fresh mount id so the previous xterm instance doesn't
        // get reused — Blazor's @key handles the DOM, but the JS handle
        // map is keyed on mountId. Rotate to keep them in sync.
        _mountId = "console-mount-" + Guid.NewGuid().ToString("N")[..8];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Snapshot the current session so a SignalR push that nulls
        // `_active` mid-await (e.g. the session failed and got removed
        // by OnStoreChanged) cannot NRE us on the post-await assignment.
        var active = _active;
        if (active is null) return;
        if (string.Equals(_attachedSessionId, active.Id, StringComparison.Ordinal)) return;
        try
        {
            await Js.InvokeVoidAsync("doxieOs.terminals.attach", _mountId, active.Id);
            _attachedSessionId = active.Id;
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            Snackbar.Add($"Could not attach terminal: {ex.Message}", Severity.Error);
        }
    }

    private async Task DetachCurrentAsync()
    {
        if (_attachedSessionId is null) return;
        try { await Js.InvokeVoidAsync("doxieOs.terminals.detach", _mountId); }
        catch (Microsoft.JSInterop.JSException) { /* page already torn down */ }
        _attachedSessionId = null;
    }

    private void OpenCreateDialog()
    {
        _createError = string.Empty;
        _createWorkspaceId = _workspaces.FirstOrDefault()?.Id ?? string.Empty;
        _showCreateDialog = true;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrEmpty(_createWorkspaceId)) return;
        _creating = true;
        try
        {
            CreateResult? result;
            try
            {
                result = await Js.InvokeAsync<CreateResult?>("doxieOs.createConsole", _createWorkspaceId);
            }
            catch (Microsoft.JSInterop.JSException ex)
            {
                _createError = $"Create failed: {ex.Message}";
                return;
            }

            if (result is null)
            {
                _createError = "Create failed: no response from server.";
                return;
            }

            if (result.Ok)
            {
                Snackbar.Add($"Started console for \"{result.Label ?? _createWorkspaceId}\"", Severity.Success);
                _showCreateDialog = false;
                Reload();
                _active = _sessions.FirstOrDefault(s => s.Id == result.Id) ?? _sessions.FirstOrDefault();
                _mountId = "console-mount-" + Guid.NewGuid().ToString("N")[..8];
            }
            else
            {
                _createError = string.IsNullOrEmpty(result.Message) ? $"HTTP {result.Status}" : result.Message!;
            }
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task CloseSession(ConsoleSession session)
    {
        try { await Js.InvokeVoidAsync("doxieOs.deleteConsole", session.Id); }
        catch (Microsoft.JSInterop.JSException) { /* will surface on reload */ }
        if (_active is not null && _active.Id == session.Id)
        {
            await DetachCurrentAsync();
            _active = null;
        }
        Reload();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        ConsoleStore.SessionCreated -= OnStoreChanged;
        ConsoleStore.SessionRemoved -= OnStoreChanged;
        ConsoleStore.SessionUpdated -= OnStoreChanged;
        await DetachCurrentAsync();
    }

    private sealed record CreateResult(bool Ok, int Status, string? Id, string? Label, string? Message);

    private static string SessionIcon(ConsoleSession session) => Icons.Material.Filled.Terminal;

    // Friendly "X ago" rendering for the session start timestamp.
    // Future timestamps (clock skew, test fixtures) just say "just now"
    // rather than rendering an awkward negative duration.
    private static string RelativeTime(DateTimeOffset utcWhen)
    {
        var delta = DateTimeOffset.UtcNow - utcWhen;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays < 7) return $"{(int)delta.TotalDays}d ago";
        if (delta.TotalDays < 30) return $"{(int)(delta.TotalDays / 7)}w ago";
        return $"{(int)(delta.TotalDays / 30)}mo ago";
    }
}
