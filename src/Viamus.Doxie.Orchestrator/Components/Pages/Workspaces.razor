@page "/workspaces"
@inject IWorkspaceStore WorkspaceStore
@inject ILibraryStore LibraryStore
@inject IAgentCatalog AgentCatalog
@inject IDoxieCatalogStore CatalogStore
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IRequestLocalityService Locality
@inject Viamus.Doxie.Orchestrator.Services.AppLanguageService Lang
@using Viamus.Doxie.Orchestrator.Runtime
@using Viamus.Doxie.Orchestrator.Agents
@using Viamus.Doxie.Orchestrator.Agents.Doxie
@using Viamus.Doxie.Orchestrator.Common

<PageTitle>@Lang["Workspaces.Title"] - DoxieOS</PageTitle>

<MudBreadcrumbs Items="Breadcrumbs" Class="px-0 mb-2" />

<div class="doxie-page">
<div class="doxie-page-header">
    <div>
        <div class="doxie-page-title">
            <span class="doxie-page-title-icon">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h3">@Lang["Workspaces.Title"]</MudText>
        </div>
        <MudText Typo="Typo.subtitle1" Class="doxie-page-subtitle">
            @Lang["Workspaces.Subtitle"]
        </MudText>
    </div>
    <div class="doxie-page-actions">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="ImportWorkspace"
                   Disabled="@_importing">
            @(_importing ? Lang["Common.Importing"] : Lang["Common.Import"])
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            @Lang["Workspaces.New"]
        </MudButton>
    </div>
</div>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudTextField @bind-Value="_searchText"
                  @bind-Value:after="@OnSearchChanged"
                  Placeholder="@Lang["Workspaces.SearchPlaceholder"]"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  DebounceInterval="150"
                  Style="max-width: 360px;" />
</MudStack>

@if (_workspaces.Count == 0)
{
    <MudPaper Class="pa-6 doxie-empty-state" Elevation="0">
        <MudText Typo="Typo.body2" Color="Color.Default">
            @Lang["Workspaces.Empty"]
        </MudText>
    </MudPaper>
}
else if (_filteredWorkspaces.Count == 0)
{
    <MudPaper Class="pa-6 doxie-empty-state" Elevation="0">
        <MudText Typo="Typo.body2" Color="Color.Default">
            No workspaces match <strong>"@_searchText"</strong>. Clear the search to see all @_workspaces.Count workspace@(_workspaces.Count == 1 ? "" : "s").
        </MudText>
    </MudPaper>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="doxie-surface">
        @foreach (var ws in _filteredWorkspaces)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@ws.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default" Style="font-family: 'Cascadia Code', Consolas, monospace;">@ws.Id</MudText>
                        </MudStack>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @LibraryCountLabel(ws.MountedLibraryIds.Count)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @AgentCountLabel(ws.MountedAgentIds.Count)
                        </MudChip>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="Download workspace bundle">
                                <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => ExportWorkspace(ws))" />
                            </MudTooltip>
                        </span>
                        <span @onclick:stopPropagation="true">
                            @if (_isLocal)
                            {
                                <MudTooltip Text="Open folder in Explorer">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="@(() => OpenWorkspace(ws, "folder"))" />
                                </MudTooltip>
                            }
                            else
                            {
                                @* Remote browser: navigate the user to the in-app
                                   file browser. Same tab — the page has its own
                                   "fullscreen" toggle if the user wants the viewer
                                   to take over the document. *@
                                <MudTooltip Text="Browse files">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   Href="@($"/workspaces/{ws.Id}/files")" />
                                </MudTooltip>
                            }
                        </span>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="Start interactive Claude console here (in DoxieOS)">
                                <MudIconButton Icon="@Icons.Material.Filled.SmartToy"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => StartConsole(ws))" />
                            </MudTooltip>
                        </span>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="Delete workspace">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteWorkspace(ws))" />
                            </MudTooltip>
                        </span>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudGrid Class="mb-3">
                        <MudItem xs="12" md="8">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Notes" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Lang["Workspaces.Why"]</MudText>
                            </MudStack>
                            @if (string.IsNullOrWhiteSpace(ws.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Default" Style="font-style: italic;">
                                    (no description set — add one when you create the next workspace so future-you knows what this is for)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@ws.Description</MudText>
                            }
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Lang["Workspaces.When"]</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">@RelativeTime(ws.CreatedAt)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@ws.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@Lang["Workspaces.MountedLibraries"]</MudText>
                    </MudStack>

                    @if (ws.MountedLibraryIds.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-2 d-block">
                            @Lang["Workspaces.NoMountedLibraries"]
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Class="flex-wrap mb-2">
                            @foreach (var libId in ws.MountedLibraryIds)
                            {
                                var lib = _librariesById.GetValueOrDefault(libId);
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Outlined"
                                         Color="@(lib is null ? Color.Warning : Color.Primary)"
                                         Icon="@Icons.Material.Filled.MenuBook"
                                         OnClose="@(() => UnmountLibrary(ws, libId))">
                                    @(lib?.Name ?? libId)@(lib is null ? " (missing)" : $" · {lib.CatalogName}")
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudSelect T="string"
                                   Label="@Lang["Workspaces.MountAnotherLibrary"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="@_pendingMountByWs.GetValueOrDefault(ws.Id)"
                                   ValueChanged="@(v => _pendingMountByWs[ws.Id] = v)"
                                   Style="min-width: 280px;">
                            @foreach (var lib in _libraries.Where(l => !ws.MountedLibraryIds.Contains(l.Id, StringComparer.OrdinalIgnoreCase)))
                            {
                                <MudSelectItem Value="@lib.Id">@lib.Name <MudText Typo="Typo.caption" Color="Color.Default" Inline="true">@($" ({lib.Id} · {lib.CatalogName})")</MudText></MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => MountLibrary(ws))"
                                   Disabled="@string.IsNullOrEmpty(_pendingMountByWs.GetValueOrDefault(ws.Id))">
                            @Lang["Workspaces.Mount"]
                        </MudButton>
                    </MudStack>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">Mounted agents</MudText>
                    </MudStack>

                    @if (ws.MountedAgentIds.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-2 d-block">
                            No agents mounted. Workspace export will include only the workspace files.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Class="flex-wrap mb-2">
                            @foreach (var agentId in ws.MountedAgentIds)
                            {
                                var agent = _agentsById.GetValueOrDefault(agentId);
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Outlined"
                                         Color="@(agent is null ? Color.Warning : Color.Primary)"
                                         Icon="@Icons.Material.Filled.SmartToy"
                                         OnClose="@(() => UnmountAgent(ws, agentId))">
                                    @(agent?.Name ?? agentId)@(agent is null ? " (missing)" : $" · {agent.CatalogName}")
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudSelect T="string"
                                   Label="Mount another agent"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Value="@_pendingAgentByWs.GetValueOrDefault(ws.Id)"
                                   ValueChanged="@(v => _pendingAgentByWs[ws.Id] = v)"
                                   Style="min-width: 280px;">
                            @foreach (var agent in _agents.Where(a => !ws.MountedAgentIds.Contains(a.Id, StringComparer.OrdinalIgnoreCase)))
                            {
                                <MudSelectItem Value="@agent.Id">@agent.Name <MudText Typo="Typo.caption" Color="Color.Default" Inline="true">@($" ({agent.Id} · {agent.CatalogName})")</MudText></MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => MountAgent(ws))"
                                   Disabled="@string.IsNullOrEmpty(_pendingAgentByWs.GetValueOrDefault(ws.Id))">
                            @Lang["Workspaces.Mount"]
                        </MudButton>
                    </MudStack>

                    <MudText Typo="Typo.caption" Color="Color.Default" Class="d-block mt-3" Style="font-family: 'Cascadia Code', Consolas, monospace; word-break: break-all;">@ws.Path</MudText>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

</div>

@if (_showCreateDialog)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudPaper Class="pa-5" Elevation="8" Style="min-width: 460px; max-width: 560px;">
            <MudText Typo="Typo.h6" Class="mb-3">@Lang["Workspaces.New"]</MudText>

            <MudTextField @bind-Value="_createId"
                          Label="@Lang["Workspaces.IdLabel"]"
                          Placeholder="my-project"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Lowercase letters, digits, hyphens. Becomes the folder name on disk."
                          FullWidth="true" />

            <MudTextField @bind-Value="_createName"
                          Label="@Lang["Workspaces.DisplayNameLabel"]"
                          Placeholder="My Project"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Falls back to title-cased id if left empty."
                          FullWidth="true"
                          Class="mt-3" />

            <MudTextField @bind-Value="_createDescription"
                          Label="@Lang["Workspaces.DescriptionLabel"]"
                          Placeholder="What is this workspace for?"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          FullWidth="true"
                          Class="mt-3" />

            <MudSelect T="string"
                       Label="@Lang["Workspaces.MountLibrariesLabel"]"
                       MultiSelection="true"
                       SelectedValues="_createSelectedLibraries"
                       SelectedValuesChanged="@(v => _createSelectedLibraries = v?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase))"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       MultiSelectionTextFunc="@(values => values is null || values.Count == 0 ? "(none)" : $"{values.Count} selected")"
                       FullWidth="true"
                       Class="mt-3"
                       HelperText="Their memories become part of this workspace's context. Can change later.">
                @foreach (var lib in _libraries)
                {
                    <MudSelectItem T="string" Value="@lib.Id">@lib.Name <MudText Typo="Typo.caption" Color="Color.Default" Inline="true">@($" ({lib.CatalogName})")</MudText></MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="Mount agents"
                       MultiSelection="true"
                       SelectedValues="_createSelectedAgents"
                       SelectedValuesChanged="@(v => _createSelectedAgents = v?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase))"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       MultiSelectionTextFunc="@(values => values is null || values.Count == 0 ? "(none)" : $"{values.Count} selected")"
                       FullWidth="true"
                       Class="mt-3"
                       HelperText="Mounted agents are bundled when this workspace is exported.">
                @foreach (var agent in _agents)
                {
                    <MudSelectItem T="string" Value="@agent.Id">@agent.Name <MudText Typo="Typo.caption" Color="Color.Default" Inline="true">@($" ({agent.CatalogName})")</MudText></MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_createError</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Text" OnClick="CancelCreateDialog">@Lang["Common.Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SubmitCreate"
                           Disabled="_creating">@Lang["Common.Create"]</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new BreadcrumbItem(Lang["Common.Home"], href: "/"),
        new BreadcrumbItem(Lang["Workspaces.Title"], href: null, disabled: true),
    ];

    private IReadOnlyList<Workspace> _workspaces = Array.Empty<Workspace>();
    private IReadOnlyList<Workspace> _filteredWorkspaces = Array.Empty<Workspace>();
    private string _searchText = string.Empty;
    private IReadOnlyList<Library> _libraries = Array.Empty<Library>();
    private Dictionary<string, Library> _librariesById = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<AgentDescriptor> _agents = Array.Empty<AgentDescriptor>();
    private Dictionary<string, AgentDescriptor> _agentsById = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<DoxieCatalogRoot> _catalogs = Array.Empty<DoxieCatalogRoot>();
    private readonly Dictionary<string, string> _pendingMountByWs = new();
    private readonly Dictionary<string, string> _pendingAgentByWs = new();
    // True when the request to /workspaces is coming from the same machine
    // as the orchestrator (so we can launch explorer.exe). False when the
    // user is reaching DoxieOS over the network and needs the in-browser
    // file browser instead. Cached at OnInitialized.
    private bool _isLocal = true;

    private bool _showCreateDialog;
    private string _createId = string.Empty;
    private string _createName = string.Empty;
    private string _createDescription = string.Empty;
    private HashSet<string> _createSelectedLibraries = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _createSelectedAgents = new(StringComparer.OrdinalIgnoreCase);
    private string _createError = string.Empty;
    private bool _creating;
    private bool _importing;
    private string _importCatalogId = DoxieCatalogStore.DefaultCatalogId;

    protected override void OnInitialized()
    {
        _isLocal = Locality.IsLocalRequest();
        Reload();
    }

    private void Reload()
    {
        _workspaces = WorkspaceStore.ListAll();
        _libraries = LibraryStore.ListAll();
        _librariesById = _libraries.ToDictionary(l => l.Id, StringComparer.OrdinalIgnoreCase);
        _agents = AgentCatalog.GetAll();
        _agentsById = _agents.ToDictionary(a => a.Id, StringComparer.OrdinalIgnoreCase);
        _catalogs = CatalogStore.ListCatalogs();
        ApplySearch();
    }

    private string LibraryCountLabel(int count)
    {
        if (count == 0)
        {
            return Lang.CurrentLanguage switch
            {
                "pt-BR" => "sem bibliotecas",
                "es" => "sin bibliotecas",
                _ => "no libraries",
            };
        }

        return Lang.CurrentLanguage switch
        {
            "pt-BR" or "es" => $"{count} biblioteca{(count == 1 ? "" : "s")}",
            _ => $"{count} librar{(count == 1 ? "y" : "ies")}",
        };
    }

    private string AgentCountLabel(int count)
    {
        if (count == 0)
        {
            return Lang.CurrentLanguage switch
            {
                "pt-BR" => "sem agentes",
                "es" => "sin agentes",
                _ => "no agents",
            };
        }

        return Lang.CurrentLanguage switch
        {
            "pt-BR" or "es" => $"{count} agente{(count == 1 ? "" : "s")}",
            _ => $"{count} agent{(count == 1 ? "" : "s")}",
        };
    }

    private void OnSearchChanged() => ApplySearch();

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _filteredWorkspaces = _workspaces;
            return;
        }

        // Match against the three fields the user actually sees on the
        // collapsed panel header — display name, kebab id, and the
        // free-text description (so a user who only remembers "the one
        // for the migration thing" can still find it).
        var needle = _searchText.Trim();
        _filteredWorkspaces = _workspaces
            .Where(w =>
                w.Name.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                w.Id.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                (w.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private void OpenCreateDialog()
    {
        _createId = string.Empty;
        _createName = string.Empty;
        _createDescription = string.Empty;
        _createSelectedLibraries = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _createSelectedAgents = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _createError = string.Empty;
        _showCreateDialog = true;
    }

    private void CancelCreateDialog()
    {
        _showCreateDialog = false;
    }

    private async Task SubmitCreate()
    {
        _createError = string.Empty;
        var rawId = (_createId ?? string.Empty).Trim();
        var normalisedId = NormaliseId(rawId);
        if (string.IsNullOrEmpty(normalisedId))
        {
            _createError = "Id is required (lowercase letters, digits, hyphens).";
            return;
        }

        var payload = new
        {
            id = normalisedId,
            name = string.IsNullOrWhiteSpace(_createName) ? null : _createName.Trim(),
            description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription.Trim(),
            libraries = _createSelectedLibraries.ToList(),
            agents = _createSelectedAgents.ToList(),
        };

        _creating = true;
        try
        {
            CreateResult? result;
            try
            {
                result = await Js.InvokeAsync<CreateResult?>("doxieOs.createWorkspace", payload);
            }
            catch (JSException ex)
            {
                _createError = $"Create failed: {ex.Message}";
                return;
            }

            if (result is null)
            {
                _createError = "Create failed: no response from server.";
                return;
            }

            if (result.Ok)
            {
                Snackbar.Add($"Created workspace \"{result.Name ?? normalisedId}\"", Severity.Success);
                _showCreateDialog = false;
                Reload();
            }
            else
            {
                _createError = string.IsNullOrWhiteSpace(result.Message)
                    ? $"HTTP {result.Status}"
                    : result.Message!;
            }
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task DeleteWorkspace(Workspace ws)
    {
        var prompt = $"Permanently delete workspace \"{ws.Name}\"?\n\nThe folder {ws.Path} will be removed from disk. This cannot be undone.";

        bool confirmed;
        try
        {
            confirmed = await Js.InvokeAsync<bool>("doxieOs.confirm", prompt);
        }
        catch (JSException)
        {
            confirmed = false;
        }
        if (!confirmed) return;

        DeleteResult? result;
        try
        {
            result = await Js.InvokeAsync<DeleteResult?>("doxieOs.deleteWorkspace", ws.Id);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
            return;
        }

        if (result is null)
        {
            Snackbar.Add("Delete failed: no response from server.", Severity.Error);
            return;
        }

        if (result.Ok)
        {
            Snackbar.Add($"Deleted workspace \"{ws.Name}\"", Severity.Success);
            Reload();
        }
        else
        {
            var detail = string.IsNullOrEmpty(result.Message) ? result.Status.ToString() : result.Message;
            Snackbar.Add($"Could not delete workspace: {detail}", Severity.Error);
        }
    }

    private async Task MountLibrary(Workspace ws)
    {
        if (!_pendingMountByWs.TryGetValue(ws.Id, out var libId) || string.IsNullOrEmpty(libId)) return;

        var newSet = ws.MountedLibraryIds.ToList();
        if (!newSet.Contains(libId, StringComparer.OrdinalIgnoreCase))
        {
            newSet.Add(libId);
        }
        await PersistMountedLibraries(ws, newSet, $"Mounted \"{_librariesById.GetValueOrDefault(libId)?.Name ?? libId}\" into {ws.Name}");
        _pendingMountByWs.Remove(ws.Id);
    }

    private async Task UnmountLibrary(Workspace ws, string libId)
    {
        var newSet = ws.MountedLibraryIds.Where(x => !string.Equals(x, libId, StringComparison.OrdinalIgnoreCase)).ToList();
        await PersistMountedLibraries(ws, newSet, $"Unmounted \"{_librariesById.GetValueOrDefault(libId)?.Name ?? libId}\" from {ws.Name}");
    }

    private async Task PersistMountedLibraries(Workspace ws, IReadOnlyList<string> libraryIds, string successMessage)
    {
        SetLibrariesResult? result;
        try
        {
            result = await Js.InvokeAsync<SetLibrariesResult?>("doxieOs.setWorkspaceLibraries", ws.Id, libraryIds);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Could not update libraries: {ex.Message}", Severity.Error);
            return;
        }

        if (result is null)
        {
            Snackbar.Add("Could not update libraries: no response from server.", Severity.Error);
            return;
        }

        if (result.Ok)
        {
            Snackbar.Add(successMessage, Severity.Success);
            Reload();
        }
        else
        {
            var detail = string.IsNullOrEmpty(result.Message) ? result.Status.ToString() : result.Message;
            Snackbar.Add($"Could not update libraries: {detail}", Severity.Error);
        }
    }

    private async Task MountAgent(Workspace ws)
    {
        if (!_pendingAgentByWs.TryGetValue(ws.Id, out var agentId) || string.IsNullOrEmpty(agentId)) return;

        var newSet = ws.MountedAgentIds.ToList();
        if (!newSet.Contains(agentId, StringComparer.OrdinalIgnoreCase))
        {
            newSet.Add(agentId);
        }
        await PersistMountedAgents(ws, newSet, $"Mounted \"{_agentsById.GetValueOrDefault(agentId)?.Name ?? agentId}\" into {ws.Name}");
        _pendingAgentByWs.Remove(ws.Id);
    }

    private async Task UnmountAgent(Workspace ws, string agentId)
    {
        var newSet = ws.MountedAgentIds.Where(x => !string.Equals(x, agentId, StringComparison.OrdinalIgnoreCase)).ToList();
        await PersistMountedAgents(ws, newSet, $"Unmounted \"{_agentsById.GetValueOrDefault(agentId)?.Name ?? agentId}\" from {ws.Name}");
    }

    private async Task PersistMountedAgents(Workspace ws, IReadOnlyList<string> agentIds, string successMessage)
    {
        SetAgentsResult? result;
        try
        {
            result = await Js.InvokeAsync<SetAgentsResult?>("doxieOs.setWorkspaceAgents", ws.Id, agentIds);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Could not update agents: {ex.Message}", Severity.Error);
            return;
        }

        if (result is null)
        {
            Snackbar.Add("Could not update agents: no response from server.", Severity.Error);
            return;
        }

        if (result.Ok)
        {
            Snackbar.Add(successMessage, Severity.Success);
            Reload();
        }
        else
        {
            var detail = string.IsNullOrEmpty(result.Message) ? result.Status.ToString() : result.Message;
            Snackbar.Add($"Could not update agents: {detail}", Severity.Error);
        }
    }

    private async Task ExportWorkspace(Workspace ws)
    {
        try
        {
            await Js.InvokeVoidAsync("doxieOs.exportWorkspace", ws.Id, true);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Could not start download: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportWorkspace()
    {
        if (_importing) return;
        var catalogId = await ChooseImportCatalog();
        if (catalogId is null) return;

        _importCatalogId = catalogId;
        _importing = true;
        try
        {
            var result = await Js.InvokeAsync<WorkspaceImportResult?>("doxieOs.pickAndImportWorkspace", false, _importCatalogId);
            if (result is null || result.Cancelled) return;

            if (!result.Ok
                && (string.Equals(result.Code, "AgentCollision", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(result.Code, "Collision", StringComparison.OrdinalIgnoreCase)))
            {
                bool confirmed;
                try
                {
                    confirmed = await Js.InvokeAsync<bool>("doxieOs.confirm",
                        $"{result.Message}\n\nReplace the existing workspace or differing agents with the imported bundle?");
                }
                catch (JSException) { confirmed = false; }
                if (!confirmed)
                {
                    Snackbar.Add("Import cancelled - existing items kept.", Severity.Info);
                    return;
                }

                result = await Js.InvokeAsync<WorkspaceImportResult?>("doxieOs.pickAndImportWorkspace", true, _importCatalogId);
                if (result is null || result.Cancelled) return;
            }

            if (result.Ok)
            {
                var imported = result.Agents?.Count(a => string.Equals(a.Action, "Imported", StringComparison.OrdinalIgnoreCase)) ?? 0;
                var replaced = result.Agents?.Count(a => string.Equals(a.Action, "Replaced", StringComparison.OrdinalIgnoreCase)) ?? 0;
                var skipped = result.Agents?.Count(a => string.Equals(a.Action, "SkippedIdentical", StringComparison.OrdinalIgnoreCase)) ?? 0;
                var agentSummary = imported + replaced + skipped > 0
                    ? $" Agents: {imported} imported, {replaced} replaced, {skipped} already identical."
                    : string.Empty;
                Snackbar.Add($"Imported workspace \"{result.WorkspaceId}\".{agentSummary}", Severity.Success);
                Reload();
            }
            else
            {
                Snackbar.Add($"Workspace import failed: {result.Message ?? "unknown error"}", Severity.Error);
            }
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Workspace import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<string?> ChooseImportCatalog()
    {
        _catalogs = CatalogStore.ListCatalogs();
        if (_catalogs.Count <= 1)
        {
            return _catalogs.FirstOrDefault()?.Id ?? DoxieCatalogStore.DefaultCatalogId;
        }

        var parameters = new DialogParameters<AgentImportDialog>
        {
            { x => x.Catalogs, _catalogs },
            { x => x.CurrentCatalogId, _importCatalogId },
            { x => x.Header, "Import workspace agents" },
        };
        var dialog = await DialogService.ShowAsync<AgentImportDialog>(
            "Import bundled agents to",
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string id } ? id : null;
    }

