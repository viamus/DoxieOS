    // Friendly "X ago" rendering for the workspace creation timestamp.
    // Future timestamps (clock skew or test fixtures) just say "just now"
    // rather than rendering an awkward negative duration.
    private static string RelativeTime(DateTime utcWhen)
    {
        var delta = DateTime.UtcNow - utcWhen;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes} min ago";
        if (delta.TotalHours < 24)
        {
            var hours = (int)delta.TotalHours;
            return $"{hours} hour{(hours == 1 ? "" : "s")} ago";
        }
        if (delta.TotalDays < 7)
        {
            var days = (int)delta.TotalDays;
            return $"{days} day{(days == 1 ? "" : "s")} ago";
        }
        if (delta.TotalDays < 30)
        {
            var weeks = (int)(delta.TotalDays / 7);
            return $"{weeks} week{(weeks == 1 ? "" : "s")} ago";
        }
        if (delta.TotalDays < 365)
        {
            var months = (int)(delta.TotalDays / 30);
            return $"{months} month{(months == 1 ? "" : "s")} ago";
        }
        var years = (int)(delta.TotalDays / 365);
        return $"{years} year{(years == 1 ? "" : "s")} ago";
    }

    private static string NormaliseId(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var lower = raw.ToLowerInvariant();
        var chars = new System.Text.StringBuilder(lower.Length);
        foreach (var ch in lower)
        {
            if ((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))
            {
                chars.Append(ch);
            }
            else if (ch == '-' || char.IsWhiteSpace(ch))
            {
                chars.Append('-');
            }
        }
        var collapsed = System.Text.RegularExpressions.Regex.Replace(chars.ToString(), "-+", "-");
        return collapsed.Trim('-');
    }

