@page "/workflows"
@using Viamus.Doxie.Orchestrator.Agents.Doxie
@using Viamus.Doxie.Orchestrator.Common

@inject IWorkflowStore WorkflowStore
@inject IWorkflowRunStore WorkflowRunStore
@inject IWorkflowRunner WorkflowRunner
@inject IDoxieCatalogStore CatalogStore
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject IDialogService Dialog
@inject Viamus.Doxie.Orchestrator.Services.AppLanguageService Lang
@implements IDisposable

<PageTitle>@Lang["Workflows.Title"] - DoxieOS</PageTitle>

<MudBreadcrumbs Items="Breadcrumbs" Class="px-0 mb-2" />

<div class="doxie-page">
<div class="doxie-page-header">
    <div>
        <div class="doxie-page-title">
            <span class="doxie-page-title-icon">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h3">@Lang["Workflows.Title"]</MudText>
        </div>
        <MudText Typo="Typo.subtitle1" Class="doxie-page-subtitle">
            @Lang["Workflows.Subtitle"]
        </MudText>
    </div>
    <div class="doxie-page-actions">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Href="/workflows/new/chat">
            @Lang["Common.BuildWithAi"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/workflows/new">
            @Lang["Workflows.New"]
        </MudButton>
    </div>
</div>

@* How runs actually happen — replaces the old "Prototype" disclaimer
   now that the runner dispatches real agent subprocesses and the
   cron daemon is wired. Kept short so the list is what dominates. *@
<MudPaper Class="pa-4 doxie-callout" Elevation="0">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
        <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" />
        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2">@Lang["Workflows.HowRunsHappen"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">
                @Lang["Workflows.HowRunsHappenBody"]
            </MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="doxie-command-bar doxie-surface">
    <MudTextField @bind-Value="_searchText"
                  @bind-Value:after="@ApplySearch"
                  Placeholder="@Lang["Workflows.SearchPlaceholder"]"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  DebounceInterval="150" />
    @if (_catalogs.Count > 1)
    {
        <MudSelect T="string"
                   Value="_selectedCatalogId"
                   ValueChanged="OnCatalogChanged"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Margin="Margin.Dense"
                   Placeholder="@Lang["Common.AllCatalogs"]"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.FolderSpecial"
                   Style="min-width: 220px;">
            <MudSelectItem T="string" Value="@AllCatalogs">@Lang["Common.AllCatalogs"]</MudSelectItem>
            @foreach (var catalog in _catalogs)
            {
                <MudSelectItem T="string" Value="@catalog.Id">@catalog.Name</MudSelectItem>
            }
        </MudSelect>
    }
    <MudTooltip Text="@Lang["Workflows.Recommend"]">
        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                       Color="Color.Primary"
                       Variant="Variant.Outlined"
                       Size="Size.Medium"
                       Disabled="@string.IsNullOrWhiteSpace(_searchText)"
                       OnClick="RecommendWorkflows" />
    </MudTooltip>
</MudStack>

@if (_workflowRecommendations.Count > 0)
{
    <MudPaper Class="pa-3 mb-3 doxie-callout" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">@Lang["Workflows.Recommended"]</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _workflowRecommendations = Array.Empty<WorkflowRecommendation>())" />
        </MudStack>
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            @foreach (var rec in _workflowRecommendations)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Primary"
                         Icon="@TriggerIcon(rec.Workflow.Trigger.Kind)"
                         OnClick="@(() => Nav.NavigateTo($"/workflows/{rec.Workflow.Id}"))"
                         title="@rec.Reason">
                    @rec.Workflow.Name
                </MudChip>
            }
        </MudStack>
    </MudPaper>
}

@if (_workflows.Count == 0)
{
    <MudPaper Class="pa-6 doxie-empty-state" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2">@Lang["Workflows.Empty"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">@Lang["Workflows.EmptyBody"]</MudText>
            </MudStack>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/workflows/new">@Lang["Workflows.New"]</MudButton>
        </MudStack>
    </MudPaper>
}
else if (_filteredWorkflows.Count == 0)
{
    <MudPaper Class="pa-6 doxie-empty-state" Elevation="0">
        <MudText Typo="Typo.body2" Color="Color.Default">
            @Lang["Workflows.NoMatch"]
        </MudText>
    </MudPaper>
}
else
{
    @* table-layout:fixed forces every <td> to honour the column widths
       declared on the <th>s — without it the browser auto-fits to
       content and a long Description blows the row up sideways. *@
    <MudTable Items="_filteredWorkflows"
              Hover="true"
              Bordered="false"
              Elevation="0"
              Class="doxie-surface"
              OnRowClick="OnRowClick"
              Style="table-layout: fixed; width: 100%;"
              T="WorkflowDefinition">
        <HeaderContent>
            <MudTh Style="width: 22%;">@Lang["Common.Name"]</MudTh>
            <MudTh>@Lang["Common.Description"]</MudTh>
            <MudTh Style="width: 120px;">@Lang["Workflows.Trigger"]</MudTh>
            <MudTh Style="width: 70px;">@Lang["Workflows.Nodes"]</MudTh>
            <MudTh Style="width: 170px;">@Lang["Workflows.LastRun"]</MudTh>
            <MudTh Style="width: 210px; text-align: right;">@Lang["Common.Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudStack Spacing="0">
                    <MudLink Href="@($"/workflows/{context.Id}")" Underline="Underline.Hover">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width: 0;">
                            <MudText Typo="Typo.body1"
                                     Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                     title="@context.Name">@context.Name</MudText>
                        </MudStack>
                    </MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Default"
                             Style="font-family: 'Cascadia Code', Consolas, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                             title="@context.Id">@context.Id</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Description">
                @* Two-line clamp keeps the row height predictable; the
                   native title attribute exposes the full text on hover
                   so nothing is permanently hidden. *@
                <MudText Typo="Typo.body2"
                         title="@context.Description"
                         Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">@context.Description</MudText>
            </MudTd>
            <MudTd DataLabel="Trigger">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="@TriggerColor(context.Trigger.Kind)"
                             Icon="@TriggerIcon(context.Trigger.Kind)">@TriggerLabel(context.Trigger)</MudChip>
                    @if (!context.Enabled)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="Color.Warning"
                                 Icon="@Icons.Material.Filled.PauseCircle">off</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Nodes">
                <MudText Typo="Typo.body2">@context.Nodes.Count</MudText>
            </MudTd>
            <MudTd DataLabel="Last run">
                @{
                    var last = WorkflowRunStore.ListByWorkflow(context.Id).FirstOrDefault();
                }
                @if (last is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">@Lang["Common.Never"]</MudText>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@RunStatusColor(last.Status)"
                                 Variant="Variant.Filled">@last.Status</MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Default">@RelativeTime(last.StartedAt)</MudText>
                    </MudStack>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <span @onclick:stopPropagation="true">
                    <MudTooltip Text="@Lang["Workflows.Run"]">
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => RunWorkflow(context))"
                                       Disabled="@(!context.Enabled)" />
                    </MudTooltip>
                    <MudTooltip Text="@Lang["Workflows.Open"]">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Href="@($"/workflows/{context.Id}")" />
                    </MudTooltip>
                    <MudTooltip Text="@Lang["Common.BuildWithAi"]">
                        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Href="@($"/workflows/new/chat?edit={context.Id}")" />
                    </MudTooltip>
                    <MudTooltip Text="@Lang["Workflows.Delete"]">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteWorkflow(context))" />
                    </MudTooltip>
                </span>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

</div>

@code {
    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new BreadcrumbItem(Lang["Common.Home"], href: "/"),
        new BreadcrumbItem(Lang["Workflows.Title"], href: null, disabled: true),
    ];
    private const string AllCatalogs = "__all";

    private IReadOnlyList<WorkflowDefinition> _workflows = Array.Empty<WorkflowDefinition>();
    private IReadOnlyList<WorkflowDefinition> _filteredWorkflows = Array.Empty<WorkflowDefinition>();
    private IReadOnlyList<WorkflowRecommendation> _workflowRecommendations = Array.Empty<WorkflowRecommendation>();
    private IReadOnlyList<DoxieCatalogRoot> _catalogs = Array.Empty<DoxieCatalogRoot>();
    private string _searchText = string.Empty;
    private string _selectedCatalogId = AllCatalogs;

    protected override void OnInitialized()
    {
        _catalogs = CatalogStore.ListCatalogs();
        Reload();
        WorkflowRunner.RunUpdated += OnRunUpdated;
    }

    public void Dispose()
    {
        WorkflowRunner.RunUpdated -= OnRunUpdated;
    }

    private async void OnRunUpdated(WorkflowRun _)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _catalogs = CatalogStore.ListCatalogs();
        _workflows = WorkflowStore.ListAll();
        ApplySearch();
    }

    private void OnCatalogChanged(string value)
    {
        _selectedCatalogId = string.IsNullOrWhiteSpace(value) ? AllCatalogs : value;
        _workflowRecommendations = Array.Empty<WorkflowRecommendation>();
        ApplySearch();
    }

    private void ApplySearch()
    {
        var needle = _searchText?.Trim() ?? string.Empty;
        _filteredWorkflows = _workflows
            .Where(MatchesCatalog)
            .Where(w => needle.Length == 0
                || w.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || w.Id.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || w.CatalogId.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || CatalogName(w.CatalogId).Contains(needle, StringComparison.OrdinalIgnoreCase)
                || w.Description.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || w.Nodes.Any(n =>
                    (n.Label?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (n.AgentId?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (n.AgentMode?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();
    }

    private bool MatchesCatalog(WorkflowDefinition workflow) =>
        string.Equals(_selectedCatalogId, AllCatalogs, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(workflow.CatalogId, _selectedCatalogId, StringComparison.OrdinalIgnoreCase);

    private string CatalogName(string catalogId) =>
        _catalogs.FirstOrDefault(c => string.Equals(c.Id, catalogId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? catalogId;

    private void RecommendWorkflows()
    {
        _workflowRecommendations = DoxieRecommendationAdvisor.RecommendWorkflows(
            _searchText,
            _workflows.Where(MatchesCatalog),
            take: 8);
        if (_workflowRecommendations.Count == 0)
        {
            Snackbar.Add("No strong workflow matches for this context yet.", Severity.Info);
        }
    }

    private void OnRowClick(TableRowClickEventArgs<WorkflowDefinition> args)
    {
        if (args.Item is not null)
        {
            Nav.NavigateTo($"/workflows/{args.Item.Id}");
        }
    }

    private async Task RunWorkflow(WorkflowDefinition wf)
    {
        // Workflow declares trigger inputs → collect them via dialog,
        // refuse to start until all required fields are filled. Without
        // declared inputs, fire immediately as before so the existing
        // demo seed (no inputs) keeps its one-click behaviour.
        Dictionary<string, string>? triggerInputs = null;
        if (wf.Trigger.Inputs is { Count: > 0 })
        {
            // Auto-prefill from the most recent run of this workflow
            // so the user only edits what changed instead of retyping
            // everything. Falls back to empty when the workflow has
            // never run.
            var lastRun = WorkflowRunStore.ListByWorkflow(wf.Id).FirstOrDefault();
            var parameters = new DialogParameters
            {
                ["Workflow"] = wf,
                ["InitialValues"] = lastRun?.TriggerInputs,
            };
            var dialog = await Dialog.ShowAsync<Viamus.Doxie.Orchestrator.Components.Workflows.WorkflowRunInputsDialog>(
                "Run", parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled) return;
            triggerInputs = result.Data as Dictionary<string, string>;
        }

        var run = WorkflowRunner.Start(wf, triggeredBy: "manual", triggerInputs);
        Snackbar.Add($"Started \"{wf.Name}\" — open the workflow to follow live", Severity.Info);
        Nav.NavigateTo($"/workflows/{wf.Id}?run={run.Id}");
    }

    private async Task DeleteWorkflow(WorkflowDefinition wf)
    {
        bool confirmed;
        try
        {
            confirmed = await Js.InvokeAsync<bool>("doxieOs.confirm",
                $"Permanently delete workflow \"{wf.Name}\"?\n\nIts run history (in-memory) is also discarded.");
        }
        catch (JSException) { confirmed = false; }
        if (!confirmed) return;

        try
        {
            WorkflowStore.Delete(wf.Id);
            Snackbar.Add($"Deleted workflow \"{wf.Name}\"", Severity.Success);
            Reload();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Could not delete: {ex.Message}", Severity.Error);
        }
    }

    private static string TriggerLabel(WorkflowTrigger t) => t.Kind switch
    {
        WorkflowTriggerKind.Cron => $"cron · {t.CronExpression ?? "?"}",
        WorkflowTriggerKind.Event => $"event · {t.EventName ?? "?"}",
        WorkflowTriggerKind.Webhook => $"hook · {t.WebhookPath ?? "?"}",
        _ => "manual",
    };

    private static string TriggerIcon(WorkflowTriggerKind kind) => kind switch
    {
        WorkflowTriggerKind.Cron => Icons.Material.Filled.Schedule,
        WorkflowTriggerKind.Event => Icons.Material.Filled.Bolt,
        WorkflowTriggerKind.Webhook => Icons.Material.Filled.Webhook,
        _ => Icons.Material.Filled.PlayArrow,
    };

    private static Color TriggerColor(WorkflowTriggerKind kind) => kind switch
    {
        WorkflowTriggerKind.Cron => Color.Info,
        WorkflowTriggerKind.Event => Color.Warning,
        WorkflowTriggerKind.Webhook => Color.Secondary,
        _ => Color.Default,
    };

    private static Color RunStatusColor(WorkflowRunStatus status) => status switch
    {
        WorkflowRunStatus.Queued => Color.Default,
        WorkflowRunStatus.Running => Color.Info,
        WorkflowRunStatus.Succeeded => Color.Success,
        WorkflowRunStatus.Failed => Color.Error,
        WorkflowRunStatus.Cancelled => Color.Warning,
        _ => Color.Default,
    };

    private static string RelativeTime(DateTimeOffset when)
    {
        var delta = DateTimeOffset.UtcNow - when;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes} min ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        return $"{(int)delta.TotalDays}d ago";
    }
}
