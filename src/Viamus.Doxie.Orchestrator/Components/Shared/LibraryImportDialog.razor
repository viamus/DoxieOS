@using Viamus.Doxie.Orchestrator.Agents.Doxie
@using Viamus.Doxie.Orchestrator.Common

<MudDialog Style="width: min(520px, 94vw);">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Import library</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2" Color="Color.Default">
                Choose where the imported library should be written.
            </MudText>
            <MudSelect T="string"
                       Value="_selectedCatalogId"
                       ValueChanged="@(v => _selectedCatalogId = string.IsNullOrWhiteSpace(v) ? DoxieCatalogStore.DefaultCatalogId : v)"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                       FullWidth="true">
                @foreach (var catalog in Catalogs)
                {
                    <MudSelectItem T="string" Value="@catalog.Id">@catalog.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.UploadFile"
                   OnClick="Import">
            Choose zip
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IReadOnlyList<DoxieCatalogRoot> Catalogs { get; set; } = Array.Empty<DoxieCatalogRoot>();
    [Parameter] public string CurrentCatalogId { get; set; } = DoxieCatalogStore.DefaultCatalogId;

    private string _selectedCatalogId = DoxieCatalogStore.DefaultCatalogId;

    protected override void OnInitialized()
    {
        _selectedCatalogId = string.IsNullOrWhiteSpace(CurrentCatalogId)
            ? DoxieCatalogStore.DefaultCatalogId
            : CurrentCatalogId;

        if (Catalogs.Count > 0 && Catalogs.All(c => !string.Equals(c.Id, _selectedCatalogId, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedCatalogId = Catalogs[0].Id;
        }
    }

    private void Import() => MudDialog.Close(DialogResult.Ok(_selectedCatalogId));

    private void Cancel() => MudDialog.Cancel();
}
