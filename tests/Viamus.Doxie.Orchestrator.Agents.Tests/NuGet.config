<?xml version="1.0" encoding="utf-8"?>
<!--
  Local NuGet config for the Viamus.Doxie.Orchestrator project.
  Isolates restore from the user-level NuGet.config (private feeds + mappings)
  so this project resolves against nuget.org only.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
