# Agent-allocated sandboxes (transient scratch work)
.sandbox/

# User-owned workspaces (persistent local project folders)
.workspace/

# Legacy workflow location kept ignored for old local checkouts.
.workflows/

# Per-run scratch folders for workflow execution.
.runs/

# Old layout (pre-2026-05 sandbox naming), kept ignored for safety.
workspace_*/

# Runtime locks / state
.claude/scheduled_tasks.lock

# Local private directory for user-owned files and experiments.
.private/

# Local dependencies, desktop bundles and test artifacts
node_modules/
dist/
release/
playwright-report/
test-results/
**/bin/
**/obj/
.vs/

# Canonical authoring layer (.doxie/) - DoxieOS reads this folder at
# runtime; provider shims are regenerated from it.
#
# The public repository ships the core agents and workflow connector definitions.
# Custom catalog content and the legacy skills layout stay local by default.
.doxie/libraries/*
.doxie/workflows/*
.doxie/skills/*
.doxie/agents/*
!.doxie/agents/agent-builder/
!.doxie/agents/workflow-builder/
!.doxie/agents/workflow-output-contract-designer/
.doxie/agents/*/*
!.doxie/agents/*/body.md
!.doxie/agents/*/manifest.json
.doxie/tools/*
!.doxie/tools/aggregate/
!.doxie/tools/approval-gate/
!.doxie/tools/if-else/
!.doxie/tools/library/
!.doxie/tools/loop/
!.doxie/tools/prompt/
!.doxie/tools/sandbox/
!.doxie/tools/write-to-workspace/
.doxie/tools/*/*
!.doxie/tools/*/body.md
!.doxie/tools/*/manifest.json
!.doxie/tools/prompt/run.md
.doxie/private/

# Provider shims - entirely derived from .doxie/, never tracked.
/AGENTS.md
.claude/
.codex/
.agents/
.mcp.json

# Local dev launcher scripts (personal convenience, not project policy)
run-*.bat
run-*.ps1
run-*.sh

# Doxie runtime evidence index (local workspace memory, never versioned)
.doxie/index/
/.doxie/run-inputs
