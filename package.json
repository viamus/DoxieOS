{
  "name": "doxieos",
  "version": "2.1.0",
  "description": "Local desktop workbench for agents and workflows",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
