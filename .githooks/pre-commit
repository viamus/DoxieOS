#!/usr/bin/env sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File tools/guard-public-content.ps1 -Staged
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File tools/guard-public-content.ps1 -Staged
elif command -v python3 >/dev/null 2>&1; then
  python3 tools/guard-public-content.py --staged
elif command -v python >/dev/null 2>&1; then
  python tools/guard-public-content.py --staged
else
  echo "Public content guard requires PowerShell or Python 3." >&2
  exit 1
fi
